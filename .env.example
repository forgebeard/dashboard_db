# === Подключение к PostgreSQL oVirt Engine ===
# Если БД на том же хосте, где запускается Docker:
DB_HOST=host.docker.internal
# Если БД на удаленном сервере, укажите IP:
# DB_HOST=192.168.1.50

DB_PORT=5432
DB_NAME=engine
DB_USER=postgres
DB_PASSWORD=changeme

# Потолок времени одного SQL-запроса в PostgreSQL (миллисекунды)
# STATEMENT_TIMEOUT_MS=30000

# Имя дампа для pytest -m integration (иначе берётся первая БД кроме postgres/template*)
# TEST_DB_NAME=67785